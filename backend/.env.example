DATABASE_URL="postgresql://user:password@localhost:5432/amazon_returns"
JWT_SECRET="replace-with-a-long-random-string"
CRON_SECRET="replace-with-a-long-random-string"

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Must be exact origins (scheme + host + port), no
# trailing slash, and no "*" — credentialed CORS requires an explicit origin.
# Defaults to "http://localhost:3000" if unset.
ALLOWED_ORIGINS="http://localhost:3000"
